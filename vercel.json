{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    { "src": "/favicon.png", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/robots.txt", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/sitemap.xml", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
